{
  "name": "pace-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "check": "tsc --noEmit",
    "build:review": "tsc --noEmit && vite build --mode review"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "mediabunny": "^1.61.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
